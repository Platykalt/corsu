root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,mjs,ts,js,html,css}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.cmd]
end_of_line = crlf

[lexicon/*.tsv]
trim_trailing_whitespace = false
